# Copy this file to .env.local and fill in your own values.
# Never commit .env.local or any real secret.

# --- Google Sheets ---
# Use ONE of the two key options below.
# Your PC and the VPS: path to the service account key file
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/path/to/credentials/keys.json
# Vercel: the whole key file as one line of text (leave the line above out there)
# GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_SHEET_TAB=Sheet1

# --- Email ---
# Gmail needs an App Password, not your normal password.
SMTP_EMAIL=you@example.com
SMTP_APP_PASSWORD=your-app-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
DIGEST_RECIPIENT_EMAIL=you@example.com
# Read your LinkedIn and Indeed job-alert emails (read-only) so those jobs show up.
# On by default once Gmail is set up. Set to false to turn it off.
READ_JOB_ALERTS=true
# How far back the first read looks, in days.
ALERTS_LOOKBACK_DAYS=14

# The search runs every few hours; the digest goes out once a day, on the
# first run at or after this hour (0-23, your computer's time).
DIGEST_HOUR=8

# --- Matching ---
MINIMUM_MATCH_SCORE=55
AUTO_APPROVE_MIN_SCORE=80
REQUIRE_REMOTE=false

# --- Email applications ---
AUTO_SEND_EMAILS=false
MAX_EMAILS_PER_RUN=10


# --- AI writing (optional, free) ---
# Rewording bullets, cover letters and outreach drafts use Google's Gemini.
# Get a free key at https://aistudio.google.com (Get API key).
GEMINI_API_KEY=

# --- Outreach emails ---
# The most outreach emails the app will send in one day, to keep it personal.
MAX_OUTREACH_PER_DAY=10

# --- Dashboard login ---
# Required on Vercel: with these empty, the dashboard refuses to start in
# production. On your own PC, leaving them empty keeps it open.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# --- Local use only (not needed on Vercel or the VPS) ---
CRON_SECRET=
ALLOW_CLEAR=false